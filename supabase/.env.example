# Secrets for the entitlement function. Copy to `supabase/.env` for local runs
# (git-ignored), and set the real values in production with:
#
#   supabase secrets set POLAR_ACCESS_TOKEN=... POLAR_ENV=production
#
# NONE of these may ever appear in the desktop app, the repo, or a log line.
# POLAR_ACCESS_TOKEN in particular is organization-wide: it can read and modify
# every customer, subscription and seat.

# Polar organization access token (Organization Settings → Developers → New Token).
# Scopes: `customers:read` (entitlement) + `checkouts:write` (create sessions).
# Nothing more — the functions never modify a customer or a subscription.
POLAR_ACCESS_TOKEN=

# Product ids for the two paid tiers, from the Polar dashboard.
# Required by the `checkout` function: a checkout session must name a product,
# and these differ between sandbox and production.
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_PRO_TEAMS=

# "production" to bill real money. Anything else, including unset, uses the
# sandbox — the same fail-safe default the retired license client had.
POLAR_ENV=sandbox

# How long the desktop app may honour a cached entitlement offline, in days.
# Also the enforcement lag for cancellations and removed team members.
OFFLINE_GRACE_DAYS=30

# Only needed if the optional webhook endpoint is ever added.
POLAR_WEBHOOK_SECRET=
